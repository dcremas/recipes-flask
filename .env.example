# Copy to /etc/recipes/recipes.env on the server (root-owned, chmod 600).
# Never commit the real file.

# psycopg 3 driver against the local Postgres on the EC2 box.
DATABASE_URL=postgresql+psycopg://recipes_app:CHANGE_ME@127.0.0.1:5432/recipes

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

FLASK_ENV=production

# The only account permitted to add, edit or delete recipes. Must match the
# email on the row in `authors`. Leave it unset and nobody can author at all.
ADMIN_EMAIL=CHANGE_ME

# Where uploaded photos are written. Must be outside the application tree:
# the systemd unit mounts /home read-only and deploy.sh rsyncs with --delete.
UPLOAD_DIR=/var/lib/recipes/uploads

# Enables 'import a recipe from a photo'. Leave blank to hide the feature.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5.
#IMPORT_MODEL=claude-opus-5

# Set to 0 only if serving over plain HTTP (cookies then work without TLS).
SESSION_COOKIE_SECURE=1
