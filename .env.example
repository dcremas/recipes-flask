# Copy to /etc/recipes/recipes.env on the server (root-owned, chmod 600).
# Never commit the real file.

# psycopg 3 driver against the local Postgres on the EC2 box.
DATABASE_URL=postgresql+psycopg://recipes_app:CHANGE_ME@127.0.0.1:5432/recipes

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

FLASK_ENV=production

# The only account permitted to add, edit or delete recipes. Must match the
# email on the row in `authors`. Leave it unset and nobody can author at all.
ADMIN_EMAIL=CHANGE_ME

# Where uploaded photos are written. Must be outside the application tree:
# the systemd unit mounts /home read-only and deploy.sh rsyncs with --delete.
UPLOAD_DIR=/var/lib/recipes/uploads

# --- 'Import a recipe from a photo' ----------------------------------------
# Which service transcribes the photo: gemini | anthropic | auto.
#   auto (default) = whichever key below is set, preferring Gemini. Set this
#   explicitly to pin the spend to one account when both keys are present.
IMPORT_PROVIDER=gemini

# Google AI Studio key (aistudio.google.com/apikey). Charges land on the Cloud
# project the key belongs to, so create it inside the project holding the
# credits — a key made in a project without billing runs on the free tier and
# spends no credits at all. GOOGLE_API_KEY is accepted as an alias.
GEMINI_API_KEY=
# Optional pin; defaults to gemini-3.7-flash, which is what production runs.
# Fall back to gemini-3.6-flash or gemini-3.5-flash if a release regresses.
# Avoid the gemini-flash-latest alias here: on a paid endpoint a model that
# moves under you changes both behavior and price with no deploy and no log
# line. `curl .../v1beta/models?key=$GEMINI_API_KEY` lists what this key serves.
#IMPORT_MODEL_GEMINI=gemini-3.7-flash

# Alternative to the key above: bill Gemini through Vertex AI, which draws on
# GCP committed-use/promotional credits that AI Studio keys may not. Needs
# Application Default Credentials on the box — a service-account JSON exported
# as GOOGLE_APPLICATION_CREDENTIALS — and the Vertex AI API enabled.
#GEMINI_USE_VERTEX=1
#GOOGLE_CLOUD_PROJECT=
#GOOGLE_CLOUD_LOCATION=us-central1
#GOOGLE_APPLICATION_CREDENTIALS=/etc/recipes/vertex-sa.json

# Anthropic key. Leave blank while running on Gemini; to switch back, fill this
# in and set IMPORT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Optional pin; defaults to claude-opus-5. (IMPORT_MODEL is the old name for
# this and is still honored.)
#IMPORT_MODEL_ANTHROPIC=claude-opus-5

# Leave every key blank to hide the feature entirely.

# --- Feedback form (foot of the home page) ---------------------------------
# Same variable names as the main site. Delivery order: SES -> SMTP -> file.
FEEDBACK_ENABLED=1
MAIL_BACKEND=auto
# Must be an SES-verified identity. Unset => messages go to MESSAGES_FILE only.
MAIL_FROM=dustincremascoli@gmail.com
MAIL_TO=dustincremascoli@gmail.com
SES_REGION=us-east-2
# Fallback store. Must be writable by the service, so it lives under
# /var/lib/recipes (covered by ReadWritePaths), never in the app tree.
MESSAGES_FILE=/var/lib/recipes/feedback.jsonl

# Set to 0 only if serving over plain HTTP (cookies then work without TLS).
SESSION_COOKIE_SECURE=1
